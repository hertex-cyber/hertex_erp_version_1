# ── Hertex ERP backend ───────────────────────────────────────────────────────
PROJECT_NAME=Hertex ERP
ENVIRONMENT=development
API_V1_STR=/api/v1

# Docker Postgres (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://hertex:hertex_dev_password@localhost:5432/hertex_erp

# Security — replace in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Integrations (optional)
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
META_APP_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Bootstrap (leave off in production; use Alembic instead)
AUTO_CREATE_TABLES=false
AUTO_SEED=false
SEED_DEMO_DATA=true

# Seed credentials (development only)
SEED_ADMIN_EMAIL=admin@hertex.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_TENANT=Hertex Demo Co
